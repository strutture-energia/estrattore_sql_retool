# Copia in `.env` e compila.

# ===== MySQL (solo lettura di information_schema) =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=readonly_user
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=nome_db

# ===== Retool (opzionale) =====
# Sessione Retool da usare sui server senza browser. Se assenti, si usa la sessione di
# `retool login` (vecchio retool-cli) salvata nel keyring del PC.
# Per ottenerle, sul PC dove `retool login` funziona:
#   node sync_retool.js --stampa-credenziali
# Quando la sessione scade vanno aggiornate (l'estrattore esce con codice 3 e lo segnala).
# RETOOL_HOST=https://struttureenergia.retool.com
# RETOOL_ACCESS_TOKEN=
# RETOOL_XSRF_TOKEN=
